# ──────────────────────────────────────────────
# HRBot — Variables de Entorno
# Copiar este archivo como .env y rellenar valores
# ──────────────────────────────────────────────

# OpenAI — API key para el agente conversador y embeddings
OPENAI_API_KEY=sk-...

# Anthropic — API key para el agente fiscalizador (Claude Sonnet)
ANTHROPIC_API_KEY=sk-ant-...

# Modelos (puedes dejar estos valores por defecto)
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-20250514
EMBEDDING_MODEL=text-embedding-3-small

# Redis local (sin contraseña para desarrollo local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# PostgreSQL — conexión para trazabilidad de interacciones
DATABASE_URL=postgresql+asyncpg://hrbot:hrbot@localhost:5432/hrbot

# RAG — cuántos fragmentos recuperar por consulta
RAG_TOP_K=5

# MCP — "direct" es el modo recomendado para local
MCP_TRANSPORT=direct

# Ruta a los documentos de política
POLICIES_DIR=docs/policies
